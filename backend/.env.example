# ========== Flask 配置 ==========
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_EXPIRE_HOURS=2

# ========== 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_NAME=student_grade_db

# ========== 连接池配置 ==========
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=15

# ========== AI 模块配置 ==========
# AI 提供者: mock / openai_compatible
AI_PROVIDER=mock

# OpenAI 兼容 API 配置（当 AI_PROVIDER=openai_compatible 时生效）
# 支持: 通义千问(DashScope)、DeepSeek、Moonshot、智谱GLM 等
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen-turbo

# AI 调用参数
AI_TIMEOUT=30
AI_MAX_INPUT_CHARS=6000
AI_MOCK_ENABLED=true

# AI 安全配置
AI_SAVE_PROMPT=false
AI_SAFETY_ENABLED=true
AI_FALLBACK_ENABLED=true

# ========== DeepSeek V4 Pro ==========
# Set AI_PROVIDER=deepseek only after providing DEEPSEEK_API_KEY.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_ENDPOINT=/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=max
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2

# ========== AI 视觉模型配置（预留） ==========
# 本版本默认使用 mock 演示，不主动调用外部视觉 API
AI_VISION_PROVIDER=openai_compatible_vision
AI_VISION_API_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_VISION_TIMEOUT=60
AI_VISION_MAX_IMAGE_MB=10

# ========== OCR ==========
# mock keeps the normal backend dependency-light. Use local in a Python 3.11/3.12 OCR environment.
OCR_PROVIDER=mock
OCR_FALLBACK_ENABLED=true
OCR_MAX_PIXELS=24000000
OCR_MAX_DIMENSION=10000
OCR_NORMALIZE_MAX_SIDE=3000
OCR_PREVIEW_DIR=
SCORE_IMPORT_PREVIEW_DIR=
USER_IMPORT_PREVIEW_DIR=
IMPORT_PREVIEW_TTL_SECONDS=1800
CLOUD_UPLOAD_ALLOWED_HOST_SUFFIXES=.tcb.qcloud.la,.tcloudbaseapp.com,.myqcloud.com,.cloudbase.net
