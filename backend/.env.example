# ========== Flask 配置 ==========
FLASK_ENV=development
SECRET_KEY=please-change-this-secret-key
JWT_SECRET_KEY=please-change-this-jwt-secret-key

# ========== 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=student_grade_db

# ========== 连接池配置 ==========
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=15

# ========== AI 模块配置 ==========
# 默认使用 mock 模式，无需外部 API Key 即可演示
AI_PROVIDER=mock
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen-turbo
AI_TIMEOUT=30
AI_MAX_INPUT_CHARS=6000
AI_MOCK_ENABLED=true
AI_SAVE_PROMPT=false
AI_SAFETY_ENABLED=true

# ========== AI 视觉模型配置（预留） ==========
AI_VISION_PROVIDER=openai_compatible_vision
AI_VISION_API_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_VISION_TIMEOUT=60
AI_VISION_MAX_IMAGE_MB=10
