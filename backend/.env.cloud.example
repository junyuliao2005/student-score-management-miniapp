FLASK_ENV=production
PORT=5000

SECRET_KEY=replace-with-a-long-random-production-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-production-secret
JWT_EXPIRE_HOURS=2

DB_HOST=your-cloud-mysql-host
DB_PORT=3306
DB_USER=your-cloud-mysql-user
DB_PASSWORD=your-cloud-mysql-password
DB_NAME=student_grade_db

AI_PROVIDER=mock
AI_MOCK_ENABLED=true
AI_FALLBACK_ENABLED=true

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_ENDPOINT=/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=max
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2

# Optional local OCR. Keep mock unless the dedicated OCR dependencies are installed.
OCR_PROVIDER=mock
OCR_FALLBACK_ENABLED=true
OCR_MAX_PIXELS=24000000
OCR_MAX_DIMENSION=10000
OCR_NORMALIZE_MAX_SIDE=3000
OCR_PREVIEW_DIR=
SCORE_IMPORT_PREVIEW_DIR=
USER_IMPORT_PREVIEW_DIR=
IMPORT_PREVIEW_TTL_SECONDS=1800
