.import-help {
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.file-name {
  color: #333333;
  font-size: 26rpx;
  margin-top: 20rpx;
  word-break: break-all;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  padding: 18rpx 8rpx;
  text-align: center;
  background: #f7f8fa;
  border-radius: 8rpx;
}

.summary-value {
  display: block;
  color: #333333;
  font-size: 34rpx;
  font-weight: 600;
}

.summary-label {
  display: block;
  color: #999999;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.text-success {
  color: #52c41a;
}

.text-warning {
  color: #faad14;
}

.row-card {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row-card:last-child {
  border-bottom: none;
}

.row-error {
  border-left: 6rpx solid #ff4d4f;
  padding-left: 16rpx;
}

.row-duplicate {
  border-left: 6rpx solid #faad14;
  padding-left: 16rpx;
}

.row-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.row-detail {
  color: #666666;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.row-errors {
  color: #ff4d4f;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.confirm-result {
  color: #333333;
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
  border-radius: 8rpx;
}

.error-card {
  border-left: 6rpx solid #ff4d4f;
}
