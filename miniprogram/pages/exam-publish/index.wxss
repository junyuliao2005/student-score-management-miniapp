.picker-box {
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background: #ffffff;
  color: #333333;
  font-size: 28rpx;
}

.switch-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
  color: #333333;
  font-size: 26rpx;
}

.input-select-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input-select-input {
  flex: 1;
  min-width: 0;
}

.input-select-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border: 1rpx solid #1890ff;
  border-radius: 8rpx;
  color: #1890ff;
  background: #ffffff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.match-warning {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #fff7e6;
  color: #d46b08;
  font-size: 24rpx;
  line-height: 1.5;
}

.action-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.confirm-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.confirm-row:last-child {
  border-bottom: none;
}
