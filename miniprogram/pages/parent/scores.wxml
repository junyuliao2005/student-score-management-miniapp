<view class="container">
  <view class="card" wx:if="{{student}}">
    <view class="card-title">{{student.student_name}} 的已发布成绩</view>
    <view class="text-muted text-small">{{student.student_id}} | {{student.class_name || '-'}}</view>
  </view>

  <view wx:if="{{loading}}" class="text-center text-muted" style="padding: 48rpx;">加载中...</view>

  <view wx:elif="{{errorText}}" class="card">
    <view class="text-center text-muted">{{errorText}}</view>
    <button class="btn-primary btn-block mt-16" bindtap="loadData">重试</button>
  </view>

  <view wx:elif="{{infoMessage}}" class="card">
    <view class="text-center text-muted">{{infoMessage}}</view>
  </view>

  <view wx:elif="{{exams.length === 0}}" class="card">
    <view class="text-center text-muted">暂无已发布成绩</view>
  </view>

  <view wx:else>
    <view class="card exam-card" wx:for="{{exams}}" wx:key="publish_id">
      <view class="flex-between mb-16">
        <view>
          <view class="text-bold">{{item.exam_name}}</view>
          <view class="text-muted text-small">{{item.term}} | {{item.exam_batch}}</view>
        </view>
        <text class="tag {{item.confirmation && item.confirmation.confirm_status === 'confirmed' ? 'tag-good' : 'tag-medium'}}">
          {{item.require_parent_signature ? (item.confirmation && item.confirmation.confirm_status === 'confirmed' ? '已确认' : '待确认') : '无需签名'}}
        </text>
      </view>

      <view class="summary-grid">
        <view class="summary-item" wx:if="{{item.settings.show_total}}">
          <text class="summary-value">{{item.totalFmt}}</text>
          <text class="summary-label">总分</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{item.avgFmt}}</text>
          <text class="summary-label">平均分</text>
        </view>
        <view class="summary-item" wx:if="{{item.settings.show_class_average && item.classAverageFmt}}">
          <text class="summary-value">{{item.classAverageFmt}}</text>
          <text class="summary-label">班级均分</text>
        </view>
      </view>

      <view wx:if="{{item.settings.show_subject_scores}}" class="subject-list">
        <view wx:for="{{item.scores}}" wx:for-item="score" wx:key="score_id" class="subject-row">
          <text>{{score.course_name || score.course_id}}</text>
          <text class="text-primary text-bold">{{score.scoreFmt}}</text>
        </view>
      </view>

      <view wx:if="{{item.summary.weak_subject_tip}}" class="weak-tip">{{item.summary.weak_subject_tip}}</view>
      <view class="text-muted text-small">发布时间：{{item.publish_time || '-'}}</view>

      <view wx:if="{{item.require_parent_signature && (!item.confirmation || item.confirmation.confirm_status !== 'confirmed')}}" class="confirm-box">
        <input class="form-input" placeholder="请输入家长姓名确认" value="{{signatureText}}" bindinput="onInput" data-field="signatureText" />
        <input class="form-input mt-12" placeholder="备注（可选）" value="{{remark}}" bindinput="onInput" data-field="remark" />
        <button class="btn-primary btn-block mt-12" bindtap="onConfirm" data-id="{{item.publish_id}}">签名确认</button>
      </view>

      <view wx:if="{{item.confirmation && item.confirmation.confirm_status === 'confirmed'}}" class="confirmed-box">
        已确认：{{item.confirmation.signature_text}} {{item.confirmation.confirmed_at}}
      </view>
    </view>
  </view>
</view>
