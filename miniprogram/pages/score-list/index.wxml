<view class="container">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-grid">
      <view class="form-item">
        <text class="form-label">学号</text>
        <view class="input-select-row">
          <input class="input-select-input" placeholder="请输入学号或点击选择" value="{{filters.student_id}}" bindinput="onFilterInput" data-field="student_id" />
          <picker mode="selector" range="{{optionMap.students}}" range-key="label" data-type="students" data-field="student_id" bindchange="onPickFilter">
            <view class="input-select-btn" bindtap="onPickerTap" data-type="students">选择</view>
          </picker>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">姓名</text>
        <view class="input-select-row">
          <input class="input-select-input" placeholder="请输入姓名或点击选择" value="{{filters.student_name}}" bindinput="onFilterInput" data-field="student_name" />
          <picker mode="selector" range="{{optionMap.student_names}}" range-key="label" data-type="student_names" data-field="student_name" bindchange="onPickFilter">
            <view class="input-select-btn" bindtap="onPickerTap" data-type="student_names">选择</view>
          </picker>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">课程号</text>
        <view class="input-select-row">
          <input class="input-select-input" placeholder="请输入课程号或点击选择" value="{{filters.course_id}}" bindinput="onFilterInput" data-field="course_id" />
          <picker mode="selector" range="{{optionMap.course_ids}}" range-key="label" data-type="course_ids" data-field="course_id" bindchange="onPickFilter">
            <view class="input-select-btn" bindtap="onPickerTap" data-type="course_ids">选择</view>
          </picker>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">班级</text>
        <view class="input-select-row">
          <input class="input-select-input" placeholder="请输入班级或点击选择" value="{{filters.class_name}}" bindinput="onFilterInput" data-field="class_name" />
          <picker mode="selector" range="{{optionMap.classes}}" range-key="label" data-type="classes" data-field="class_name" bindchange="onPickFilter">
            <view class="input-select-btn" bindtap="onPickerTap" data-type="classes">选择</view>
          </picker>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">学期</text>
        <view class="input-select-row">
          <input class="input-select-input" placeholder="请输入学期或点击选择" value="{{filters.term}}" bindinput="onFilterInput" data-field="term" />
          <picker mode="selector" range="{{optionMap.terms}}" range-key="label" data-type="terms" data-field="term" bindchange="onPickFilter">
            <view class="input-select-btn" bindtap="onPickerTap" data-type="terms">选择</view>
          </picker>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">考试批次</text>
        <view class="input-select-row">
          <input class="input-select-input" placeholder="请输入批次或点击选择" value="{{filters.exam_batch}}" bindinput="onFilterInput" data-field="exam_batch" />
          <picker mode="selector" range="{{optionMap.exam_batches}}" range-key="label" data-type="exam_batches" data-field="exam_batch" bindchange="onPickFilter">
            <view class="input-select-btn" bindtap="onPickerTap" data-type="exam_batches">选择</view>
          </picker>
        </view>
      </view>
    </view>
    <view class="filter-row">
      <button class="btn-primary btn-small filter-btn" bindtap="onSearch">查询</button>
      <button class="btn-outline btn-small filter-btn" bindtap="onReset">重置</button>
      <button wx:if="{{perms.canCreateScore}}" class="btn-success btn-small filter-btn" bindtap="onAdd">新增</button>
      <button class="btn-outline btn-small filter-btn" bindtap="onExportScores">批量导出</button>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="text-center text-muted" style="padding: 48rpx;">
    加载中...
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{list.length === 0}}" class="text-center text-muted" style="padding: 80rpx;">
    <view style="font-size: 64rpx; margin-bottom: 16rpx;">📋</view>
    <view>暂无成绩数据</view>
  </view>

  <!-- 成绩列表 -->
  <view wx:else>
    <view class="card" wx:for="{{list}}" wx:key="score_id">
      <view wx:if="{{item.isGroupStart}}" class="student-group-title">
        {{item.student_name || item.student_id}}（{{item.student_id}}）｜{{item.class_name || '-'}}
      </view>
      <view class="flex-between mb-16">
        <view>
          <text class="text-bold">{{item.student_name || item.student_id}}</text>
          <text class="text-muted text-small" style="margin-left: 8rpx;">{{item.student_id}}</text>
        </view>
        <text class="tag {{item.levelTagClass}}">{{item.level_tag || '-'}}</text>
      </view>

      <view class="score-info-grid">
        <view class="score-info-item">
          <text class="score-info-label">班级</text>
          <text class="score-info-value">{{item.class_name || '-'}}</text>
        </view>
        <view class="score-info-item">
          <text class="score-info-label">课程</text>
          <text class="score-info-value">{{item.course_name || item.course_id}}</text>
        </view>
        <view class="score-info-item">
          <text class="score-info-label">分数</text>
          <text class="score-info-value text-primary text-bold">{{item.score}}</text>
        </view>
        <view class="score-info-item">
          <text class="score-info-label">批次</text>
          <text class="score-info-value">{{item.exam_batch}}</text>
        </view>
      </view>

      <!-- 统计信息 -->
      <view class="score-stats-row" wx:if="{{item.total_score !== null}}">
        <view class="score-stat-item">
          <text class="score-stat-label">总分</text>
          <text class="score-stat-value">{{item.totalScoreFmt}}</text>
        </view>
        <view class="score-stat-item">
          <text class="score-stat-label">均分</text>
          <text class="score-stat-value">{{item.avgScoreFmt}}</text>
        </view>
        <view class="score-stat-item">
          <text class="score-stat-label">排名</text>
          <text class="score-stat-value">{{item.rankFmt}}</text>
        </view>
      </view>

      <!-- 评语 -->
      <view wx:if="{{item.comment_text}}" class="score-comment">
        <text class="text-small text-muted">评语：</text>
        <text class="text-small">{{item.comment_text}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="score-actions" wx:if="{{perms.canUpdateScore}}">
        <button class="btn-outline btn-small" bindtap="onEdit" data-item="{{item}}">编辑</button>
        <button class="btn-danger btn-small" bindtap="onDelete" data-id="{{item.score_id}}" data-name="{{item.student_name}}">删除</button>
      </view>
    </view>

    <!-- 分页 -->
    <view class="pagination">
      <button class="btn-outline btn-small" disabled="{{page <= 1}}" bindtap="onPrevPage">上一页</button>
      <text class="pagination-info">{{page}} / {{totalPages}}</text>
      <button class="btn-outline btn-small" disabled="{{page >= totalPages}}" bindtap="onNextPage">下一页</button>
    </view>
  </view>
</view>
