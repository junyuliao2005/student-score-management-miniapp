<view class="container login-container">
  <!-- Logo -->
  <view class="login-header">
    <view class="login-logo">📚</view>
    <view class="login-title">学生成绩管理系统</view>
    <view class="login-subtitle">请登录以继续</view>
  </view>

  <!-- 登录表单 -->
  <view class="card login-card">
    <view class="form-group">
      <text class="form-label">用户名</text>
      <input
        class="form-input {{errors.username ? 'form-input-error' : ''}}"
        placeholder="请输入用户名"
        value="{{username}}"
        bindinput="onUsernameInput"
        maxlength="30"
      />
      <text wx:if="{{errors.username}}" class="form-error">{{errors.username}}</text>
    </view>

    <view class="form-group">
      <text class="form-label">密码</text>
      <input
        class="form-input {{errors.password ? 'form-input-error' : ''}}"
        placeholder="请输入密码"
        password="true"
        value="{{password}}"
        bindinput="onPasswordInput"
        maxlength="30"
      />
      <text wx:if="{{errors.password}}" class="form-error">{{errors.password}}</text>
    </view>

    <button
      class="btn-primary btn-block"
      bindtap="onLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      登录
    </button>
  </view>

  <view wx:if="{{showDevRequestMode}}" class="card dev-mode-card">
    <view class="dev-mode-title">开发请求模式</view>
    <view class="dev-mode-switch" role="group" aria-label="开发请求模式">
      <view
        class="dev-mode-option {{requestMode === 'local' ? 'dev-mode-option-active' : ''}}"
        data-mode="local"
        bindtap="onRequestModeChange"
      >本地</view>
      <view
        class="dev-mode-option {{requestMode === 'cloud' ? 'dev-mode-option-active' : ''}}"
        data-mode="cloud"
        bindtap="onRequestModeChange"
      >云端</view>
    </view>
    <view class="dev-mode-hint">本地真机调试请将 BASE_URL 改为电脑局域网地址</view>
  </view>

  <!-- 测试账号提示 -->
  <view class="card test-accounts">
    <view class="card-title">测试账号</view>
    <view class="account-list">
      <view class="account-item" bindtap="fillAccount" data-username="admin01" data-password="123456">
        <text class="account-role tag tag-excellent">管理员</text>
        <text class="account-info">admin01 / 123456</text>
      </view>
      <view class="account-item" bindtap="fillAccount" data-username="teacher01" data-password="123456">
        <text class="account-role tag tag-good">教师</text>
        <text class="account-info">teacher01 / 123456</text>
      </view>
      <view class="account-item" bindtap="fillAccount" data-username="S001" data-password="123456">
        <text class="account-role tag tag-medium">学生端</text>
        <text class="account-info">演示学生 S001 / 123456</text>
      </view>
      <view class="account-item" bindtap="fillAccount" data-username="parent01" data-password="123456">
        <text class="account-role tag tag-pass">家长端</text>
        <text class="account-info">parent01 / 123456</text>
      </view>
    </view>
  </view>

  <view class="privacy-link" bindtap="showPrivacyNotice">隐私说明</view>
</view>
