<view class="container">
  <!-- 输入区域 -->
  <view class="card">
    <view class="card-title">AI 学习建议</view>

    <!-- 学生ID（教师/管理员可见） -->
    <view wx:if="{{canInputStudentId}}" class="form-group">
      <text class="form-label">学号</text>
      <input
        class="form-input"
        placeholder="请输入学号"
        value="{{studentId}}"
        bindinput="onStudentIdInput"
      />
    </view>

    <view class="form-group">
      <text class="form-label">学期</text>
      <input
        class="form-input"
        placeholder="如 2025-2026-2"
        value="{{term}}"
        bindinput="onTermInput"
      />
    </view>

    <button
      class="btn-primary btn-block"
      bindtap="onGenerate"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      生成学习建议
    </button>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="text-center text-muted" style="padding: 48rpx;">
    AI 正在分析中...
  </view>

  <!-- 结果展示 -->
  <view wx:if="{{result}}">
    <mock-badge visible="{{result.is_mock}}" text="AI 演示模式" />

    <!-- 优势科目 -->
    <ai-result-card
      title="优势科目"
      text="{{result.strengths}}"
    />

    <!-- 薄弱科目 -->
    <ai-result-card
      title="薄弱科目"
      text="{{result.weaknesses}}"
    />

    <!-- 学习建议 -->
    <ai-result-card
      title="学习建议"
      items="{{result.advice}}"
    />

    <!-- 复习重点 -->
    <ai-result-card
      title="复习重点"
      text="{{result.focus}}"
    />

    <!-- 鼓励评语 -->
    <ai-result-card
      title="鼓励评语"
      text="{{result.encouragement}}"
    />

    <!-- 元信息 -->
    <view class="card">
      <view class="meta-row">
        <text class="meta-label">分析ID</text>
        <text class="meta-value">{{result.analysis_id}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">分析引擎</text>
        <text class="meta-value">{{result.provider}}</text>
      </view>
    </view>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{errorMsg}}" class="card" style="border-left: 6rpx solid #ff4d4f;">
    <text class="text-danger">{{errorMsg}}</text>
  </view>

  <!-- 返回首页 -->
  <view class="text-center mt-32">
    <navigator url="/pages/home/index" open-type="switchTab" class="text-primary">
      返回首页
    </navigator>
  </view>
</view>
