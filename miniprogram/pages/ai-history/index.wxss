.page-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.history-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.history-header,
.feedback-row,
.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: 600;
}

.mode-tag {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #e8f3ff;
  color: #1769aa;
  font-size: 24rpx;
}

.mode-mock {
  background: #fff7e6;
  color: #9a6700;
}

.history-meta {
  color: #64748b;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.history-summary {
  margin: 16rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
  color: #334155;
  white-space: normal;
  overflow-wrap: anywhere;
}

.feedback-row {
  justify-content: flex-start;
}

.feedback-active {
  border: 1rpx solid #16803a;
  color: #16803a;
  background: #ecfdf3;
}

.feedback-negative {
  border: 1rpx solid #c53030;
  color: #c53030;
  background: #fff5f5;
}

.pagination {
  margin-top: 28rpx;
}

.state-text,
.state-block {
  padding: 60rpx 12rpx;
  text-align: center;
  color: #64748b;
}
