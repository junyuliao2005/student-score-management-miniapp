.tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
  overflow-x: auto;
}

.tab {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  color: #666666;
  font-size: 26rpx;
  background: #ffffff;
}

.tab-active {
  color: #1890ff;
  border-color: #1890ff;
  background: #e6f7ff;
}

.picker-box {
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background: #ffffff;
  color: #333333;
  font-size: 28rpx;
}

.empty-contact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border: 1rpx solid #ffd591;
  border-radius: 8rpx;
  background: #fff7e6;
  color: #ad6800;
  font-size: 26rpx;
}

.contact-status {
  padding: 18rpx 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background: #f7f8fa;
  color: #666666;
  font-size: 26rpx;
}

.reload-contact-btn {
  flex-shrink: 0;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  padding: 18rpx 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.message-card {
  border-left: 6rpx solid transparent;
}

.message-unread {
  border-left-color: #1890ff;
}

.message-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  margin-right: 16rpx;
}

.message-meta {
  color: #999999;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.message-content {
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 16rpx;
  white-space: pre-wrap;
}

.error-card {
  border-left: 6rpx solid #ff4d4f;
}
