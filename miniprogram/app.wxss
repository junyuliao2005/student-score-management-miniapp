/* ========== 全局基础样式 ========== */

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* ========== 容器 ========== */

.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 卡片 ========== */

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* ========== 按钮 ========== */

.btn-primary {
  background: #1890ff;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #a0cfff;
  color: #ffffff;
}

.btn-success {
  background: #52c41a;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-success::after {
  border: none;
}

.btn-warning {
  background: #faad14;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-warning::after {
  border: none;
}

.btn-danger {
  background: #ff4d4f;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-danger::after {
  border: none;
}

.btn-outline {
  background: #ffffff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
  border-radius: 12rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-outline::after {
  border: none;
}

.btn-block {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

/* ========== 表单 ========== */

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  background: #ffffff;
}

.form-input:focus {
  border-color: #1890ff;
}

.form-input-error {
  border-color: #ff4d4f;
}

.form-error {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-picker-arrow {
  color: #999999;
  font-size: 24rpx;
}

/* ========== 表格 ========== */

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 24rpx;
}

.table-header {
  background: #fafafa;
}

.table-header .table-cell {
  font-weight: 600;
  color: #666666;
}

.table-row {
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  padding: 16rpx 12rpx;
  text-align: center;
  word-break: break-all;
}

/* ========== 标签 ========== */

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.5;
}

.tag-excellent {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.tag-good {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

.tag-medium {
  background: #fff7e6;
  color: #faad14;
  border: 1rpx solid #ffd591;
}

.tag-pass {
  background: #fff2e8;
  color: #fa8c16;
  border: 1rpx solid #ffbb96;
}

.tag-fail {
  background: #fff1f0;
  color: #ff4d4f;
  border: 1rpx solid #ffa39e;
}

.tag-warning-low {
  background: #fff1f0;
  color: #ff4d4f;
  border: 1rpx solid #ffa39e;
}

.tag-warning-bias {
  background: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #ffbb96;
}

/* ========== 提示 ========== */

.toast-success {
  background: #f6ffed;
  color: #52c41a;
}

.toast-error {
  background: #fff1f0;
  color: #ff4d4f;
}

.toast-warning {
  background: #fff7e6;
  color: #faad14;
}

/* ========== 辅助类 ========== */

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-primary {
  color: #1890ff;
}

.text-success {
  color: #52c41a;
}

.text-warning {
  color: #faad14;
}

.text-danger {
  color: #ff4d4f;
}

.text-muted {
  color: #999999;
}

.text-small {
  font-size: 24rpx;
}

.text-bold {
  font-weight: 600;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.mb-32 {
  margin-bottom: 32rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* ========== 筛选栏 ========== */

.filter-bar {
  background: #ffffff;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-item {
  flex: 1;
  min-width: 200rpx;
}

.filter-input {
  height: 64rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  width: 100%;
}

.filter-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

/* ========== 分页 ========== */

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.pagination-info {
  font-size: 24rpx;
  color: #999999;
}

/* ========== 统计卡片 ========== */

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  min-width: 200rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1890ff;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
  display: block;
}

/* ========== 功能入口 ========== */

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.menu-item {
  width: calc(33.33% - 16rpx);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.menu-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  display: block;
}

.menu-text {
  font-size: 24rpx;
  color: #333333;
  display: block;
}
