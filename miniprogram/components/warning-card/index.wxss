.warning-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #ff4d4f;
}

.warning-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.warning-title {
  display: flex;
  align-items: center;
}

.warning-body {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.warning-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 8rpx 0;
}

.warning-label {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
  min-width: 100rpx;
}

.warning-value {
  font-size: 26rpx;
  color: #333333;
  word-break: break-all;
}
