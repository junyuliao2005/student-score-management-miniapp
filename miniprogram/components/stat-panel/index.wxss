.stat-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  min-width: 160rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1890ff;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
  display: block;
}
